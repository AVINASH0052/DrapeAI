# Admin console env (Vite)

# Firebase web client (public config — same project as the mobile app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Usually empty — Vite proxies /admin to localhost:8000 in dev;
# production Worker keeps /admin same-origin.
VITE_API_BASE_URL=
VITE_ENV=development
