{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sugatai-admin",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "API_ORIGIN": "https://api.sugatai.com"
  },
  "routes": [
    { "pattern": "app.sugatai.com", "custom_domain": true }
  ]
}
