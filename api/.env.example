# development | staging | production. The app refuses to boot on any other
# value. `development` unlocks the test-token auth bypass, permissive CORS and
# /docs — never set it on a public host.
ENVIRONMENT=development
DATABASE_URL=postgresql://drapeai:drapeai@localhost:5432/drapeai

# Set to 1 in production deployments. Boot fails if ENVIRONMENT is anything
# other than `production`, which turns a typo into a crash instead of a silent
# auth bypass. Already set in infra/docker-compose.prod.yml.
REQUIRE_PRODUCTION=

# Browser origins allowed in production (comma-separated). Ignored in
# development, where any origin is accepted.
CORS_ORIGINS=https://sugatai.com,https://www.sugatai.com,https://app.sugatai.com

# AI providers (set whichever you use — try-on tries all configured keys in order)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=

# Google Gemini (API key path — wardrobe vision + Developer API try-on fallback)
# GEMINI_MODEL_IMAGE=gemini-2.5-flash-image
# GEMINI_MODEL_IMAGE_HD=gemini-2.5-flash-image

# Vertex AI (preferred try-on — bills Google Cloud / starter credits)
# Service account JSON path (never commit this file). ADC also works on GCE/Cloud Run.
GOOGLE_CLOUD_PROJECT=sugatai
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
# VERTEX_MODEL_IMAGE / VERTEX_MODEL_IMAGE_HD: latest available on Vertex for this
# project is currently gemini-2.5-flash-image (gemini-3* / imagen-4 were 404).
VERTEX_MODEL_IMAGE=gemini-2.5-flash-image
VERTEX_MODEL_IMAGE_HD=gemini-2.5-flash-image
VERTEX_SPEND_CAP_USD=25

# Monthly spend caps in USD, enforced per provider before every AI call.
# A provider over its cap is skipped and the next one in the cascade is tried;
# when all are over, try-on falls back to the local composite.
# TOTAL_SPEND_CAP_USD is the backstop and also applies to any provider that has
# no cap of its own.
OPENAI_SPEND_CAP_USD=15
ANTHROPIC_SPEND_CAP_USD=10
GEMINI_SPEND_CAP_USD=20
CLOUDFLARE_SPEND_CAP_USD=10
RUNPOD_SPEND_CAP_USD=15
NVIDIA_SPEND_CAP_USD=5
GROQ_SPEND_CAP_USD=5
TOTAL_SPEND_CAP_USD=60

# Per-role model overrides (optional — see api/app/config.py for defaults)
# Wardrobe detect/tag uses Gemini vision by default when GEMINI_API_KEY is set.
# MODEL_VISION_PRIMARY=gemini-3.5-flash
# GEMINI_MODEL_VISION=gemini-3.5-flash
# MODEL_RANK_PRIMARY=
# MODEL_CHAT_PRIMARY=
# MODEL_EMBED_PRIMARY=
# MODEL_REASON_PRIMARY=

# Cloudflare Workers AI (optional try-on fallback) + R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=drapeai-images
# Unused for private closet/avatar/try-on objects. Production issues signed URLs.
# Keep the R2 bucket private.
R2_PUBLIC_URL=
# Lifetime of signed image URLs in seconds (default 3600).
SIGNED_URL_TTL_SEC=3600

# Outfit try-on provider priority (Vertex primary draws on Cloud credits)
# With RunPod IDM-VTON as primary (best garment fidelity, but see the
# RUNPOD_TRYON_TIMEOUT_SEC note below re: cold-start time):
#   TRYON_PROVIDER_PRIMARY=runpod
#   TRYON_MODEL_PRIMARY=idm-vton
#   RUNPOD_API_KEY=
#   RUNPOD_ENDPOINT_ID=
TRYON_PROVIDER_PRIMARY=vertex
TRYON_MODEL_PRIMARY=gemini-2.5-flash-image
TRYON_PROVIDER_SECONDARY=gemini
TRYON_MODEL_SECONDARY=gemini-2.5-flash-image
# OpenAI image-edit path (when used): always prefer HD
TRYON_IMAGE_QUALITY=high
TRYON_IMAGE_SIZE=1024x1536
TRYON_PROVIDER_TERTIARY=cloudflare
TRYON_MODEL_TERTIARY=@cf/black-forest-labs/flux-2-klein-9b
TRYON_PROVIDER_QUATERNARY=nvidia
TRYON_MODEL_QUATERNARY=qwen/qwen-image-edit
TRYON_FALLBACK_COMPOSITE=true
TRYON_PROMPT_VERSION=wardrobe_v1
TRYON_DAILY_LIMIT_FREE=5
TRYON_ASYNC=true
TRYON_ENABLED=true
# Pre-flight vision-LLM check on person/garment photos before generating —
# catches unusable references (e.g. back-view garment shots) up front.
TRYON_INPUT_CHECK_ENABLED=true
TRYON_JOB_TIMEOUT_SEC=120
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# If RunPod endpoint has workersMin=0, the first request after any idle
# period cold-starts (~10-15 min measured live: image pull + model load).
# Warm requests are seconds. If using RunPod as primary:
#   RUNPOD_TRYON_TIMEOUT_SEC=900   # must cover the cold-start case
#   TRYON_JOB_TIMEOUT_SEC=600      # DB staleness check (2x this) must
#                                   # also exceed RUNPOD_TRYON_TIMEOUT_SEC
#   TRYON_ASYNC=true                # never block a sync HTTP request on this
#   Also bump `job_timeout` in app/workers/worker.py's WorkerSettings —
#   ARQ kills the background task at that ceiling regardless of the above.
RUNPOD_TRYON_TIMEOUT_SEC=300

# Must match the mobile app GoogleService-Info.plist / google-services.json project_id
FIREBASE_PROJECT_ID=drapeai-b5af6

# Monitoring (production only)
SENTRY_DSN=

# Required in production (rate limits + ARQ). Optional in local development.
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
