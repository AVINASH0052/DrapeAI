ENVIRONMENT=development
DATABASE_URL=postgresql://drapeai:drapeai@localhost:5432/drapeai

# AI providers (set whichever you use — try-on tries all configured keys in order)
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Outfit try-on provider priority (nvidia | openai | gemini)
TRYON_PROVIDER_PRIMARY=nvidia
TRYON_MODEL_PRIMARY=qwen/qwen-image-edit
TRYON_PROVIDER_SECONDARY=openai
TRYON_MODEL_SECONDARY=gpt-image-1
TRYON_PROVIDER_TERTIARY=gemini
TRYON_MODEL_TERTIARY=gemini-2.5-flash-image
TRYON_FALLBACK_COMPOSITE=true

FIREBASE_PROJECT_ID=

# Cloudflare R2 (production only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=drapeai-images
R2_PUBLIC_URL=

# Monitoring (production only)
SENTRY_DSN=

LOG_LEVEL=INFO
