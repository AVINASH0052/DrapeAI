{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sugatai-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "WAITLIST",
      "id": "067eeb6aa58245c6b2dfda09f61580bc"
    }
  ],
  "routes": [
    { "pattern": "sugatai.com", "custom_domain": true },
    { "pattern": "www.sugatai.com", "custom_domain": true }
  ]
}
